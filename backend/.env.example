# Copiar a backend/.env y ajustar. También se pueden usar variables de entorno reales.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rutaflex
# Usa el usuario con permisos mínimos creado por backend/roles.sql (no el superusuario postgres).
DB_USER=rutaflex_app
DB_PASS=cambia_esto

# Duración de una sesión, en horas (después hay que volver a iniciar sesión).
SESSION_HOURS=12

# Orígenes permitidos (CORS), separados por coma. Vacío = solo mismo origen. En desarrollo con Vite usa el proxy y déjalo vacío.
CORS_ORIGIN=

# Modo exposición: permite POST /api/reset (borra todo y carga los datos ficticios).
# Déjalo en false en producción.
DEMO_MODE=false
