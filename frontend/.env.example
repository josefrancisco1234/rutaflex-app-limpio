# URL base del backend PHP. Todos los endpoints son POST (/data, /sync, /login, /reset).
# En desarrollo, Vite reenvía /api a http://localhost:8000.
# Si se borra esta variable, la app funciona en modo local (localStorage).
VITE_API_URL=/api

# Modo exposición: perfiles ficticios, laboratorio de exposición y guía de evidencias.
# En producción déjalo en false (la app arranca con la base vacía). Debe coincidir con DEMO_MODE del backend.
VITE_DEMO=false
